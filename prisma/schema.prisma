// 1. Prisma Client Ayarları
generator client {
  provider = "prisma-client-js"
}

// 2. Veritabanı Bağlantı Ayarları (URL artık prisma.config.ts'den gelecek)
datasource db {
  provider = "postgresql" 
}

// ----------------------------------------------------------------------
// 👤 KULLANICI VE ERİŞİM SİSTEMİ (Önceki Tablolar)
// ----------------------------------------------------------------------

model User {
  id            String   @id @default(cuid()) 
  username      String   @unique              
  displayName   String?                       
  password      String                        
  isAdmin       Int      @default(0)          
  isVip         Int      @default(0)          
  isCorporate   Int      @default(0)          
  cookieId      String?  @unique              
  trackingId    String?  @unique // Analitik tablosundaki trackingId ile eşleşebilir
  roleColor     String?                       
  createdAt     DateTime @default(now())      
  updatedAt     DateTime @updatedAt           
}

model AccessCode {
  id             Int      @id @default(autoincrement())
  code           String   @unique              
  targetUsername String                        
  isCorporate    Int      @default(0)          
  isVip          Int      @default(0)          
  isAdmin        Int      @default(0)          
  assignedColor  String?                       
  isUsed         Boolean  @default(false)      
  createdAt      DateTime @default(now())
}

model LoginCode {
  id              Int      @id @default(autoincrement())
  code            String   @unique              
  userId          String?                       
  usageCount      Int      @default(1)          
  isPasswordReset Boolean  @default(false)      
  isAdminLogin    Boolean  @default(false)      
  createdAt       DateTime @default(now())
}

// ----------------------------------------------------------------------
// 🕵️ HASAN YUSUF'UN ÖZEL ANALİTİK VE TAKİP SİSTEMİ (Yeni Tablolar)
// ----------------------------------------------------------------------

// 1. Ziyaretçi Kimliği (Core dosyasının işleyeceği çerez/cihaz verileri)
model UserInfo {
  id          String   @id @default(cuid())
  trackingId  String   @unique // Kullanıcıya atanan o "kalıcı" ve değişmeyen çerez ID'si
  ipAddress   String?  // Kullanıcının IP adresi
  country     String?  // iplocation.io vb. servislerden gelen Ülke
  city        String?  // Şehir
  userAgent   String?  // Tarayıcı ve İşletim Sistemi bilgisi
  browserLang String?  // Tarayıcının varsayılan dili (Örn: tr, en, de)
  deviceType  String?  // Mobile, Desktop, Tablet vb.
  lastVisit   DateTime @default(now()) // Siteye son giriş yaptığı an (Her girişte güncellenir)
  createdAt   DateTime @default(now()) // Siteye ilk girdiği an (Değişmez)
}

// 2. Sayfa Ziyaret Geçmişi (Kullanıcının site içindeki yolculuğu)
model UserPageRecord {
  id         Int      @id @default(autoincrement())
  trackingId String   // Hangi ziyaretçi? (UserInfo'daki trackingId ile eşleşir)
  path       String   // Hangi sayfaya girdi? (Örn: /portfolio/e-ticaret, /contact)
  referrer   String?  // Siteye nereden geldi? (Google, doğrudan link, vb.)
  stepOrder  Int      // Bu sayfaya kaçıncı sırada girdi? (1. sayfa, 2. sayfa...)
  visitedAt  DateTime @default(now()) // Sayfaya girdiği tam tarih ve saat
}

// 3. Genel Sayfa İstatistikleri (Sadece senin admin panelinde göreceğin sayaçlar)
model PageAnalytic {
  id        Int      @id @default(autoincrement())
  path      String   @unique // Örn: /home, /portfolio/proje-1
  daily     Int      @default(0) // Günlük ziyaretçi
  weekly    Int      @default(0) // Haftalık ziyaretçi
  monthly   Int      @default(0) // Aylık ziyaretçi
  yearly    Int      @default(0) // Yıllık ziyaretçi
  total     Int      @default(0) // Tüm zamanların toplamı
  updatedAt DateTime @updatedAt  // Sayacın en son güncellendiği zaman
}